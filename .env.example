# Environment Variables

# Backend
ENVIRONMENT=development
HOST=127.0.0.1
# The server stores derived SQLite state at <vault>/.flux/index.db when a vault is selected.
# Leave unset to start without a vault or persistent database.
# FLUX_VAULT_PATH=/path/to/your/vault
CORS_ALLOWED_ORIGIN=http://localhost:3000
PORT=8080
